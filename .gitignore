# Private workbench material. This is a stable namespace, not a per-file list.
/.juicer-local/
/AGENTS.md
# Retired testing material is kept locally with its original relative paths.
/ArchiveOldTestingFiles/
# Existing path-sensitive harnesses remain a single quarantined legacy bucket.
/tools/

# Local support material; these directories are intentionally absent from the
# published source tree.
/docs/
/installer/
/validation/

# VS user state
.vs/
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates

# Build output
/out/
/CMakeUserPresets.json
# Product CMake inputs remain visible even with a local *.txt exclusion.
!CMakeLists.txt
!/tests/requirements.txt
!/third_party/**/*.txt
[Bb]in/
[Oo]bj/
Debug*/
Release*/
x64/
x86/
ARM*/
ipch/
*.opendb
*.VC.db

