# Private workbench material. This is a stable namespace, not a per-file list.
/.juicer-local/
/AGENTS.md
# Retired testing material is kept locally with its original relative paths.
/ArchiveOldTestingFiles/
# Existing path-sensitive harnesses remain a single quarantined legacy bucket.
/tools/

# Local support material; public product documentation under /docs is tracked.
# Private documentation belongs under the ignored /.juicer-local/ namespace.
/installer/
/validation/

# VS user state
.vs/
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates

# Build output
/out/
/target/
/CMakeUserPresets.json
# Product CMake inputs remain visible even with a local *.txt exclusion.
!CMakeLists.txt
!/tests/requirements.txt
!/third_party/**/*.txt
[Bb]in/
[Oo]bj/
Debug*/
Release*/
x64/
x86/
ARM*/
ipch/
*.opendb
*.VC.db

# Intermediates
*.obj
*.pch
*.pdb
*.idb
*.ilk
*.tlog
*.log

# Packaging / deps
packages/
vcpkg_installed/
.conan/
*.nupkg

# Others
*.cache
*.tmp
*.temp
*.rsp
*.lastbuildstate
*.zip
/DaVinci_Resolve_17_Wide_Gamut_Intermediate.pdf
