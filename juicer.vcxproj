    <MakeDir Directories="$(IntDir)manual_cuda" />
    <Message Importance="High" Text="Compiling CUDA with nvcc: %(JuicerManualCudaCompile.Identity)" />
    <Exec Command="set &quot;CL=&quot; &amp;&amp; set &quot;INCLUDE=$(JuicerNvccHostIncludePath)&quot; &amp;&amp; &quot;$(CudaToolkitDir)bin\nvcc.exe&quot; -c &quot;%(JuicerManualCudaCompile.FullPath)&quot; --std=c++20 --cudart hybrid $(JuicerNvccReleaseDeviceOptions) $(JuicerNvccFastMathOptions) -ccbin &quot;$(JuicerNvccHostCompilerBin)&quot; -I&quot;$(ProjectDir)src&quot; -I&quot;$(ProjectDir)third_party&quot; -I&quot;$(CudaToolkitDir)include&quot; -DWIN32 -DNOMINMAX -D_CRT_SECURE_NO_WARNINGS -DJUICER_ENABLE_CUDA=1 -DJUICER_CUDA_SELF_CHECK=$(JuicerCudaSelfCheck) -DJUICER_CUDA_VALIDATE_PRIMITIVES=$(JuicerCudaValidatePrimitives) -DJUICER_DIAGNOSTICS_COMPILED=$(JuicerDiagnosticsCompiled) -DJUICER_SPD_DEBUG=$(JuicerSpdDebug) -DJUICER_SPD_DEBUG_MAX_SAMPLES=$(JuicerSpdDebugMaxSamples) -DJUICER_RM_TELEMETRY_COUNTERS_COMPILED=$(JuicerRmTelemetryCountersCompiled) -DJUICER_LAUNCH_GRAPH_COUNTERS_COMPILED=$(JuicerLaunchGraphCountersCompiled) -gencode=arch=compute_75,code=sm_75 -gencode=arch=compute_75,code=compute_75 -Xcompiler &quot;$(JuicerNvccHostCompilerOptions)&quot; -o &quot;%(JuicerManualCudaCompile.ObjectFile)&quot;" />
  </Target>
  <Target Name="JuicerManualCudaLinkInputs"
          Condition="'$(JuicerUseManualNvcc)'=='1'"
          DependsOnTargets="JuicerManualNvccCompile"
          BeforeTargets="ComputeLinkInputsFromProject">
    <ItemGroup>
      <Object Include="@(JuicerManualCudaCompile->'%(ObjectFile)')">
        <LinkCompiled>true</LinkCompiled>
      </Object>
    </ItemGroup>
  </Target>
  <Target Name="JuicerCleanManualCudaObjects"
          Condition="'$(JuicerUseManualNvcc)'=='1'"
          BeforeTargets="Clean">
    <Delete Files="@(JuicerManualCudaCompile->'%(ObjectFile)')" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\CUDA 13.2.targets" Condition="'$(JuicerUseCudaMsbuildTargets)'=='1' and Exists('$(VCTargetsPath)\BuildCustomizations\CUDA 13.2.targets')" />
  </ImportGroup>
</Project>
