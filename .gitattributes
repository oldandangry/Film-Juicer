# --- Core: normalize text ---
* text=auto eol=lf

# Source and headers (let auto handle them)
*.c        text
*.cpp      text
*.h        text
*.hpp      text
*.inl      text
*.ixx      text
*.rc       text
*.def      text
*.manifest text
*.natvis   text
*.cmake    text
CMakeLists.txt text
*.hlsl     text
*.glsl     text

# Documentation & config as text
*.md       text
*.txt      text
*.json     text
*.yml      text
*.yaml     text
*.xml      text
*.ini      text
.editorconfig text
.gitattributes text
.gitignore text

# Scripts: enforce OS-appropriate EOL on checkout
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.sh       text eol=lf

# --- Binary & artifacts: never diff/merge/normalize ---
# (binary implies -diff; add -text to block normalization explicitly)
*.png  binary -text
*.jpg  binary -text
*.jpeg binary -text
*.gif  binary -text
*.tif  binary -text
*.bmp  binary -text
*.ico  binary -text
*.exe  binary -text
*.dll  binary -text
*.lib  binary -text
*.pdb  binary -text
*.obj  binary -text
*.pch  binary -text
*.ilk  binary -text
*.idb  binary -text
*.zip  binary -text
*.7z   binary -text
*.tar  binary -text
*.gz   binary -text
*.rar  binary -text
*.pdf  binary -text
*.bin  binary -text
*.f32  binary -text
*.npy  binary -text
*.npz  binary -text
*.dat  binary -text

*.csv text eol=lf

# Preserve the original bytes of platform-specific native illuminant captures.
rust/film-juicer-core/tests/fixtures/illuminants/*.bits -text whitespace=cr-at-eol

# Preserve the original bytes of provenance-pinned native CAT16 captures.
rust/film-juicer-core/tests/fixtures/color/*.json -text whitespace=cr-at-eol

# Preserve whitespace in byte-identifiable vendored dependency snapshots.
third_party/nlohmann/LICENSE.MIT -whitespace
# Retain complete upstream Rust notice bytes across native Git transports.
third_party/rust/*/* -text -whitespace
third_party/ofxs/Legal/OFXS-LICENSE.txt -whitespace
third_party/ofxs/OpenFX-1.4/include/ofxImageEffect.h -whitespace

