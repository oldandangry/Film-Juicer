# --- Core: normalize text ---
* text=auto eol=lf

# Source and headers (let auto handle them)
*.c        text
*.cpp      text
*.h        text
*.hpp      text
*.inl      text
*.ixx      text
*.rc       text
*.def      text
*.manifest text
*.natvis   text
*.cmake    text
CMakeLists.txt text
*.hlsl     text
*.glsl     text

# Documentation & config as text
*.md       text
*.txt      text
*.json     text
*.yml      text
*.yaml     text
*.xml      text
*.ini      text
.editorconfig text
.gitattributes text
.gitignore text

# Scripts: enforce OS-appropriate EOL on checkout
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.sh       text eol=lf

# --- Binary & artifacts: never diff/merge/normalize ---
# (binary implies -diff; add -text to block normalization explicitly)
*.png  binary -text
*.jpg  binary -text
*.jpeg binary -text
*.gif  binary -text
*.tif  binary -text
*.bmp  binary -text
*.ico  binary -text
*.exe  binary -text
*.dll  binary -text
*.lib  binary -text
*.pdb  binary -text
*.obj  binary -text
*.pch  binary -text
*.ilk  binary -text
*.idb  binary -text
*.zip  binary -text
*.7z   binary -text
*.tar  binary -text
*.gz   binary -text
*.rar  binary -text
*.pdf  binary -text

*.csv text eol=lf

# Preserve the original bytes of provenance-pinned CUDA pixel fixtures.
tests/ofx/processor_rust_pixels_*.dat -text whitespace=cr-at-eol

# Preserve the original bytes of platform-specific native illuminant captures.
tests/ffi/fixtures/illuminants/*.bits -text whitespace=cr-at-eol

# Preserve the original bytes of provenance-pinned native CAT16 captures.
tests/ffi/fixtures/color/*.json -text whitespace=cr-at-eol

# Preserve whitespace in byte-identifiable vendored dependency snapshots.
third_party/nlohmann/LICENSE.MIT -whitespace
third_party/ofxs/Legal/OFXS-LICENSE.txt -whitespace
third_party/ofxs/OpenFX-1.4/include/ofxImageEffect.h -whitespace
third_party/ofxs/Support/LICENSE -whitespace
third_party/ofxs/Support/Library/ofxsCore.cpp -whitespace
third_party/ofxs/Support/include/ofxsInteract.h -whitespace

# Preserve reviewed bytes of A5 numerical and GPU replay fixtures.
tests/ffi/fixtures/exposure/** -text whitespace=cr-at-eol
tests/ofx/fixtures/exposure/** -text whitespace=cr-at-eol

# Preserve original bytes of provenance-pinned native input-hull captures.
tests/ffi/fixtures/input_hull/** -text whitespace=cr-at-eol

# Preserve original bytes of provenance-pinned native output-gamut captures.
tests/ffi/fixtures/output_gamut/** -text whitespace=cr-at-eol

# A10 native words and oracle provenance must survive both native Git transports.
tests/ffi/fixtures/output-color/*.json -text

# Independent S4.B film-development captures preserve exact fixture bytes.
tests/film/fixtures/** -text whitespace=cr-at-eol

# Independent S4.B film-input compound captures preserve native bytes.
tests/film/input-fixtures/*.json -text whitespace=cr-at-eol

# Independent S4.B DIR/density captures preserve reviewed native bytes.
tests/film/dir-fixtures/*.json -text whitespace=cr-at-eol

# Independent S4.B visual-grain captures preserve exact native bytes.
tests/film/grain-fixtures/** -text whitespace=cr-at-eol

# Physical-effects native characterization preserves exact words and provenance bytes.
tests/film/effects-fixtures/** -text whitespace=cr-at-eol

# Spatial-optics native characterization preserves exact words and provenance bytes.
tests/film/optics-fixtures/** -text whitespace=cr-at-eol

# Filtered print illuminant characterization preserves exact native capture bytes.
tests/print/illuminant-fixtures/** -text whitespace=cr-at-eol

# Preflash native characterization preserves exact input/output and provenance bytes.
tests/print/preflash-fixtures/** -text whitespace=cr-at-eol

