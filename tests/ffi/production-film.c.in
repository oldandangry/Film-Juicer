static FjDiffusionParams optics_diffusion_input(size_t index, size_t base, size_t flag) {
    FjDiffusionParams out = {0};
    double* fields[] = {&out.strength, &out.spatial_scale, &out.halo_warmth, &out.core_intensity,
        &out.core_size, &out.halo_intensity, &out.halo_size, &out.bloom_intensity, &out.bloom_size};
    out.active = optics_input_flags[index][flag];
    out.family = optics_input_flags[index][flag + 1];
    for (size_t i = 0; i < 9; ++i) memcpy(fields[i], &optics_input_doubles[index][base + i], sizeof(double));
    return out;
}
static int optics_fields(const FjSpatialOpticsRecipe* out, size_t index) {
    const FjDiffusionRecipe* recipes[] = {&out->camera_diffusion, &out->enlarger_diffusion};
    for (size_t component = 0; component < 2; ++component) {
        const FjDiffusionRecipe* r = recipes[component];
        const double values[] = {r->scatter_fraction, r->group_weights[0], r->group_weights[1],
            r->group_weights[2], r->group_lambda_um[0], r->group_lambda_um[1], r->group_lambda_um[2],
            r->warmth, r->spatial_scale};
        for (size_t i = 0; i < 9; ++i) {
            uint64_t word;
            memcpy(&word, &values[i], sizeof(word));
            if (word != optics_doubles[index][component * 9 + i]) return 0;
        }
    }
    const FjHalationRecipe* h = &out->scatter_halation;
    const float values[] = {out->camera_lens_blur.sigma_um, h->scatter_amount, h->scatter_spatial_scale,
        h->halation_spatial_scale, h->first_sigma_um[0], h->first_sigma_um[1], h->first_sigma_um[2],
        h->total_strength[0], h->total_strength[1], h->total_strength[2]};
    const uint32_t flags[] = {out->camera_diffusion.domain, out->camera_diffusion.active, out->camera_diffusion.family,
        out->enlarger_diffusion.domain, out->enlarger_diffusion.active, out->enlarger_diffusion.family,
        h->scatter_active, h->back_reflection_active};
    const uint64_t hashes[] = {out->camera_diffusion.resolved_hash, out->camera_diffusion.hash,
        out->enlarger_diffusion.resolved_hash, out->enlarger_diffusion.hash, out->camera_lens_blur.hash, h->hash, out->hash};
    if (!words(values, optics_floats[index], 10)) return 0;
    for (size_t i = 0; i < 8; ++i) if (flags[i] != optics_flags[index][i]) return 0;
    for (size_t i = 0; i < 7; ++i) if (hashes[i] != optics_hashes[index][i]) return 0;
    return 1;
}
static int optics_values(void) {
    SpatialOpticsPrepare prepare = fj_legacy_spatial_optics_prepare;
    const uint32_t expected[15][5] = {{0,0,0,0,3},{0,0,0,0,3},{0,0,0,0,3},{0,0,0,0,3},{0,0,0,0,3},{0,0,0,0,3},
        {3,2,1,2,3},{3,2,1,1,3},{3,2,4,1,3},{3,2,1,2,3},{3,3,2,15,3},{3,4,3,16,0},{3,2,1,13,3},{2,1,0,0,3},{2,1,0,0,3}};
    for (size_t index = 0; index < 15; ++index) {
