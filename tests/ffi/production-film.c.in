    CHECK(duplicate_failure.reason == FJ_FILM_RECIPE_LOG_EXPOSURE && duplicate_failure.channel == 3 && duplicate_failure.sample == 1);
    duplicate_params.active = 0;
    CHECK(status(fj_legacy_film_dir_acquire(owner, &duplicate_params, &duplicate_dir, &duplicate_failure, NULL), FJ_STATUS_SUCCESS));
    CHECK(status(fj_legacy_film_dir_release(duplicate_dir, NULL), FJ_STATUS_SUCCESS));
    duplicate_params.active = 1; duplicate_params.inhibition_same_layer = 0; duplicate_params.inhibition_interlayer = 0;
    CHECK(status(fj_legacy_film_dir_acquire(owner, &duplicate_params, &duplicate_dir, &duplicate_failure, NULL), FJ_STATUS_SUCCESS));
    FjFilmDirView duplicate_view = {0};
    CHECK(status(fj_legacy_film_dir_view(duplicate_dir, &duplicate_view, &duplicate_failure, NULL), FJ_STATUS_SUCCESS));
