static int lut_fields(FjScannerLutFailure f, uint32_t reason, uint32_t buffer, uint64_t index, uint32_t channel) {
    return f.reason==reason && f.buffer==buffer && f.index==index && f.channel==channel;
}
static void lut_report(const char* name, FjStatus s, FjScannerLutFailure f) {
    printf("SCANNER_LUT_CASE %s category=%u api=%u native_code=%lld reason=%u channel=%u index=%llu buffer=%u fields=pass\n", name,s.category,s.api,(long long)s.native_code,f.reason,f.channel,(unsigned long long)f.index,f.buffer);
}
static FjScannerLutInput lut_input(float spectra[7][3], uint32_t resolution) {
    FjScannerLutInput in={0};
    memcpy(spectra[0],lut_input_eps_c,12);memcpy(spectra[1],lut_input_eps_m,12);memcpy(spectra[2],lut_input_eps_y,12);
    memcpy(spectra[3],lut_input_weighted_x,12);memcpy(spectra[4],lut_input_weighted_y,12);memcpy(spectra[5],lut_input_weighted_z,12);memcpy(spectra[6],lut_input_baseline,12);
    in.eps_c=(FjFloatSpan){spectra[0],3};in.eps_m=(FjFloatSpan){spectra[1],3};in.eps_y=(FjFloatSpan){spectra[2],3};
