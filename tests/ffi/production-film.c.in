static int lut_view_words(FjScannerLutView v,uint32_t r) {
    const FjFloatSpan arrays[]={v.log2_xyz,v.slope_c,v.slope_m,v.slope_y,v.cell_min,v.cell_max};
    const uint32_t* expected2[]={lut_2_log2_xyz,lut_2_slope_c,lut_2_slope_m,lut_2_slope_y,lut_2_cell_min,lut_2_cell_max};
    const uint32_t* expected3[]={lut_3_log2_xyz,lut_3_slope_c,lut_3_slope_m,lut_3_slope_y,lut_3_cell_min,lut_3_cell_max};
    CHECK(v.resolution==r);
    for(size_t i=0;i<6;++i) {size_t side=i<4?r:r-1;size_t count=3*side*side*side;CHECK(arrays[i].data && arrays[i].count==count && words(arrays[i].data,(r==2?expected2:expected3)[i],count));}
    return 0;
}
static int lut_empty(FjScannerLutView v) {
    const FjFloatSpan arrays[]={v.log2_xyz,v.slope_c,v.slope_m,v.slope_y,v.cell_min,v.cell_max};
    if(v.resolution) return 0;
    for(size_t i=0;i<6;++i) if(arrays[i].data || arrays[i].count) return 0;
    return 1;
}
