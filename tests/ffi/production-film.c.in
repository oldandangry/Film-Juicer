static int effects_values(void) {
    PhysicalEffectsPrepare prepare = fj_legacy_physical_effects_prepare;
    for (size_t index = 0; index < 9; ++index) {
        FjPhysicalEffectsParams params = {0};
        memcpy(&params.film_dust_amount, &effects_amounts[index][0], sizeof(float));
        memcpy(&params.film_scratch_amount, &effects_amounts[index][1], sizeof(float));
        memcpy(&params.gate_dust_amount, &effects_amounts[index][2], sizeof(float));
        memcpy(&params.gate_scratch_amount, &effects_amounts[index][3], sizeof(float));
        memcpy(&params.gate_weave_amount, &effects_weave_input[index], sizeof(double));
        params.grain_active = effects_grain_active[index];
        params.grain_debug_view = effects_debug[index];
        FjPhysicalEffectsRecipe out = {0};
        effects_seed(&out);
        FjFilmRecipeFailure failure = {99, 99, 99};
        FjStatus value = prepare(index == 8 ? NULL : &params, &out, &failure, NULL);
        CHECK(status(value, index < 7 ? FJ_STATUS_SUCCESS : FJ_STATUS_UNSUPPORTED_INPUT));
        CHECK(failure.reason == (index < 7 ? FJ_FILM_RECIPE_REASON_NONE : FJ_FILM_RECIPE_RAW) && failure.channel == 3 && failure.sample == UINT64_MAX);
        CHECK(effects_fields(&out, index));
        printf("EFFECTS_CASE %s category=%u api=%u native_code=%lld reason=%u channel=%u sample=%llu fields=156-pass\n", effects_names[index], value.category, value.api, (long long)value.native_code, failure.reason, failure.channel, (unsigned long long)failure.sample);
    }
    return 0;
}


