    f=(FjScannerLutFailure){99,99,99,99};result=fj_legacy_scanner_lut_acquire(&base,(FjScannerLutOwner**)(uintptr_t)1,&f,NULL);CHECK(status(result,2)&&lut_fields(f,1,0,UINT64_MAX,UINT32_MAX));lut_report("LUT-FAIL-INDEPENDENT-OUTPUT-CLEAR",result,f);
    FjErrorBuffer malformed={NULL,1,99};FjScannerLutOwner* owner=(FjScannerLutOwner*)(uintptr_t)0x5555;
