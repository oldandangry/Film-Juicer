    FjScannerLutOwner* owner=(FjScannerLutOwner*)(uintptr_t)0x5555;FjScannerLutFailure f={99,99,99,99};
    char text[256];FjErrorBuffer error={text,sizeof(text),99};
    FjStatus result=fj_legacy_scanner_lut_acquire(&in,&owner,&f,&error);
    CHECK(status(result,category) && !owner && lut_fields(f,reason,buffer,index,channel));
    CHECK(error.length<sizeof(text) && text[error.length]==0);
    CHECK(strcmp(text,reason==1?"invalid scanner LUT arguments":reason==2?"canonical scan LUT resolution must be at least two":reason==3?"scanner LUT dimensions exceed addressable capacity":"canonical scan LUT build produced non-finite log2 XYZ")==0);
    lut_report(name,result,f);return 0;
}
static int scanner_lut_values(void) {
