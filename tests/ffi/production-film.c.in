    assets = NULL;
    CHECK(status(fj_legacy_assets_create(duplicate_path, &assets, NULL), FJ_STATUS_SUCCESS));
    CHECK(status(fj_legacy_film_profile_acquire(assets, selected, &profile, NULL), FJ_STATUS_SUCCESS));
    CHECK(status(fj_legacy_film_development_acquire(profile, 0, 1, 0, &owner, NULL), FJ_STATUS_SUCCESS));
    FjFilmDirParams duplicate_params = {0};
    duplicate_params.active = 1; duplicate_params.amount = 1;
    duplicate_params.inhibition_same_layer = 1; duplicate_params.inhibition_interlayer = 1;
    duplicate_params.gamma_use_stock = 1;
    FjFilmRecipeFailure duplicate_failure = {0};
