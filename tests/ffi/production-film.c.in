    in=base;in.eps_c.data=NULL;CHECK(lut_reject("LUT-FAIL-MISSING-SPAN",in,2,1,0,UINT64_MAX,UINT32_MAX)==0);
    in=base;in.weighted_z.count=2;CHECK(lut_reject("LUT-FAIL-MISMATCHED-SPAN",in,2,1,0,UINT64_MAX,UINT32_MAX)==0);
    in=base;in.medium=256;CHECK(lut_reject("LUT-FAIL-MEDIUM-256",in,2,1,0,UINT64_MAX,UINT32_MAX)==0);
    in=base;in.has_baseline=2;CHECK(lut_reject("LUT-FAIL-BOOLEAN-2",in,2,1,0,UINT64_MAX,UINT32_MAX)==0);
    in=base;in.sample_count=0;in.eps_c=in.eps_m=in.eps_y=in.weighted_x=in.weighted_y=in.weighted_z=in.baseline_min=(FjFloatSpan){(const float*)(uintptr_t)1,SIZE_MAX};
    CHECK(lut_reject("LUT-MEDIUM-K0",in,3,5,0,0,0)==0);
