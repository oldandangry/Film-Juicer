static FjStatus lut_expiring_acquire(uint32_t resolution,FjScannerLutOwner** owner,FjScannerLutFailure* failure,FjErrorBuffer* error) {
    float spectra[7][3];FjScannerLutInput in=lut_input(spectra,resolution);
