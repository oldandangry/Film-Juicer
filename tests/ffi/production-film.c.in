    CHECK(status(fj_legacy_film_development_acquire(profile, 99, 1, 0, &owner, &error), FJ_STATUS_UNSUPPORTED_INPUT) && !owner && error.length < sizeof(message) && !message[error.length]);
    CHECK(status(fj_legacy_film_development_acquire(profile, 2, 1, 0, &owner, NULL), FJ_STATUS_UNSUPPORTED_INPUT) && !owner);
    CHECK(status(fj_legacy_film_development_acquire(profile, 0, 0, 0, &owner, NULL), FJ_STATUS_UNSUPPORTED_INPUT) && !owner);
    CHECK(status(fj_legacy_film_development_acquire(profile, 0, 1, 99, &owner, NULL), FJ_STATUS_UNSUPPORTED_INPUT) && !owner);
    CHECK(status(fj_legacy_film_development_acquire(NULL, 0, 1, 0, &owner, NULL), FJ_STATUS_UNSUPPORTED_INPUT) && !owner);
