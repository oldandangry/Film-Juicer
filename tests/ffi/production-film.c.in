        in=(FjScannerLutInput){0};in.eps_c=in.eps_m=in.eps_y=(FjFloatSpan){&zero,1};
        in.weighted_x=(FjFloatSpan){channel==0?&one:&zero,1};in.weighted_y=(FjFloatSpan){channel==1?&one:&zero,1};in.weighted_z=(FjFloatSpan){channel==2?&one:&zero,1};
        in.baseline_min=(FjFloatSpan){&baseline,1};in.sample_count=1;in.inv_yn=1;in.has_baseline=1;in.medium=1;in.resolution=2;
        in.inverse_span_cmy[0]=in.inverse_span_cmy[1]=in.inverse_span_cmy[2]=1;
        const char* names[]={"LUT-SPECTRAL-EARLY-X","LUT-SPECTRAL-EARLY-Y","LUT-SPECTRAL-EARLY-Z"};CHECK(lut_reject(names[channel],in,3,5,0,0,channel)==0);
    }
