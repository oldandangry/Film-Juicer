static void post_report(const char* name, FjStatus s, FjScannerPostEffectsFailure f, uint64_t hash) {
    printf("SCANNER_POST_CASE %s category=%u api=%u native_code=%d reason=%u lane=%u fields=13-pass hash=%" PRIu64 "\n", name, s.category, s.api, s.native_code, f.reason, f.lane, hash);
}
static void post_words(const FjScannerPostEffectsDescriptor* d, uint32_t words[12]) {
    words[0]=d->route; words[1]=d->glare_active;
    memcpy(words+2,&d->glare_percent,4);memcpy(words+3,&d->glare_roughness,4);
    memcpy(words+4,&d->glare_blur_sigma_px,4);memcpy(words+5,&d->lens_blur_sigma_px,4);
    memcpy(words+6,&d->unsharp_sigma_px,4);memcpy(words+7,&d->unsharp_amount,4);
    words[8]=(uint32_t)d->glare_blur_radius;words[9]=(uint32_t)d->lens_blur_radius;
    words[10]=(uint32_t)d->unsharp_radius;words[11]=d->schema;
}
static int post_cases(void) {
    const FjScannerPostEffectsDescriptor zero={0};
    const FjScannerPostEffectsFailure no_failure={0};
    FjScannerPostEffectsDescriptor out;
    FjScannerPostEffectsFailure failure;
    FjScannerPostEffectsInput active={1,1,2.0f,0.3f,0.7f,1.25f,0.7f,0.8f};
    for(size_t i=0;i<sizeof(post_input_words)/sizeof(post_input_words[0]);++i) {
        FjScannerPostEffectsInput input;
        uint32_t words[12];
        memcpy(&input,post_input_words[i],sizeof input);
        char text[256]="seed";
        FjErrorBuffer error={text,sizeof text,99};
        memset(&out,0xa5,sizeof out);memset(&failure,0xa5,sizeof failure);
        FjStatus s=fj_legacy_scanner_post_describe(&input,&out,&failure,&error);
        CHECK(s.category==post_envelopes[i][0] && s.api==0 && s.native_code==0 && failure.reason==post_envelopes[i][3] && failure.lane==post_envelopes[i][4]);
        CHECK(strcmp(text,post_diagnostics[i])==0 && error.length==strlen(text));
        const FjScannerPostEffectsDescriptor* value=s.category==0?&out:&failure.rejected;
        post_words(value,words);
        CHECK(memcmp(words,post_expected_words[i],sizeof words)==0 && value->hash==post_hashes[i]);
        if(s.category) {CHECK(memcmp(&out,&zero,sizeof out)==0);}
        else {CHECK(memcmp(&failure,&no_failure,sizeof failure)==0);}
        post_report(post_names[i],s,failure,value->hash);
    }
    for(unsigned lane=1;lane<=3;++lane) {
        FjScannerPostEffectsInput input=active;
        const float threshold=2147483648.0f/3.0f;
        if(lane==1) input.glare_blur_sigma_px=threshold;
        if(lane==2) input.lens_blur_sigma_px=threshold;
        if(lane==3) {input.unsharp_sigma_px=threshold;input.unsharp_amount=0;}
        char text[256]={0};FjErrorBuffer error={text,sizeof text,99};
        memset(&out,0xa5,sizeof out);memset(&failure,0xa5,sizeof failure);
        FjStatus s=fj_legacy_scanner_post_describe(&input,&out,&failure,&error);
        CHECK(s.category==3 && s.api==0 && s.native_code==0 && failure.reason==3 && failure.lane==lane);
        CHECK(memcmp(&out,&zero,sizeof out)==0 && memcmp(&failure.rejected,&zero,sizeof zero)==0);
        CHECK(strcmp(text,"scanner post-effects Gaussian radius outside int32 range")==0 && error.length==strlen(text));
        char name[32];snprintf(name,sizeof name,"radius-%u",lane);post_report(name,s,failure,0);
    }
    for(unsigned i=0;i<7;++i) {
        FjScannerPostEffectsInput input=active;
        const FjScannerPostEffectsInput* argument=&input;
        FjScannerPostEffectsDescriptor* output=&out;
        FjScannerPostEffectsFailure* details=&failure;
        char text[256]={0};FjErrorBuffer error={text,sizeof text,99};
        if(i==0) argument=NULL;
        if(i==1) output=NULL;
        if(i==2) details=NULL;
        if(i==3) input.route=4;
        if(i==4) input.glare_active=2;
        if(i==5) {error.data=NULL;error.capacity=1;}
        if(i==6) argument=(const FjScannerPostEffectsInput*)((const char*)&input+1);
        memset(&out,0xa5,sizeof out);memset(&failure,0xa5,sizeof failure);
        FjStatus s=fj_legacy_scanner_post_describe(argument,output,details,&error);
        CHECK(s.category==2 && s.api==0 && s.native_code==0);
        if(output) {CHECK(memcmp(&out,&zero,sizeof out)==0);}
        if(details) {CHECK(failure.reason==1 && failure.lane==0 && memcmp(&failure.rejected,&zero,sizeof zero)==0);}
        if(i==5) {CHECK(error.length==0);}
        else {CHECK(strcmp(text,"invalid scanner post-effects arguments")==0 && error.length==strlen(text));}
        char name[32];snprintf(name,sizeof name,"raw-%u",i);post_report(name,s,details?failure:no_failure,0);
    }
    FjErrorBuffer empty={(char*)(uintptr_t)1,0,99};
    CHECK(status(fj_legacy_scanner_post_describe(&active,&out,&failure,&empty),0) && empty.length==0);
    CHECK(out.hash==post_hashes[100] && memcmp(&failure,&no_failure,sizeof failure)==0);
    CHECK(status(fj_legacy_scanner_post_describe(&active,&out,&failure,NULL),0));
    return 0;
}

_Static_assert(sizeof(FjGaussianKernelInput)==8 && _Alignof(FjGaussianKernelInput)==4 && offsetof(FjGaussianKernelInput,radius)==0 && offsetof(FjGaussianKernelInput,sigma_px)==4, "Gaussian input ABI");
_Static_assert(sizeof(FjGaussianKernelView)==24 && _Alignof(FjGaussianKernelView)==8 && offsetof(FjGaussianKernelView,radius)==0 && offsetof(FjGaussianKernelView,sigma_px)==4 && offsetof(FjGaussianKernelView,weights)==8 && offsetof(FjFloatSpan,data)==0 && offsetof(FjFloatSpan,count)==8, "Gaussian view ABI");
_Static_assert(sizeof(FjGaussianKernelFailure)==4 && _Alignof(FjGaussianKernelFailure)==4 && offsetof(FjGaussianKernelFailure,reason)==0, "Gaussian failure ABI");
_Static_assert(_Generic(&fj_legacy_gaussian_kernel_acquire, FjStatus (*)(const FjGaussianKernelInput*, FjGaussianKernelOwner**, FjGaussianKernelFailure*, FjErrorBuffer*):1, default:0), "Gaussian acquire signature");
_Static_assert(_Generic(&fj_legacy_gaussian_kernel_view, FjStatus (*)(const FjGaussianKernelOwner*, FjGaussianKernelView*, FjGaussianKernelFailure*, FjErrorBuffer*):1, default:0), "Gaussian view signature");
_Static_assert(_Generic(&fj_legacy_gaussian_kernel_release, FjStatus (*)(FjGaussianKernelOwner*, FjErrorBuffer*):1, default:0), "Gaussian release signature");
static void gaussian_result(const char* name, FjStatus s, uint32_t reason, const FjGaussianKernelView* view) {
    uint32_t sigma = 0;
    if (view) memcpy(&sigma, &view->sigma_px, sizeof sigma);
    printf("GAUSSIAN_CASE {\"case\":\"%s\",\"envelope\":[%u,%u,%d,%u],\"radius\":%d,\"sigma_bits\":%u,\"weights\":[",name,s.category,s.api,s.native_code,reason,view?view->radius:0,sigma);
    if (view) for (size_t i=0;i<view->weights.count;++i) {
        uint32_t word; memcpy(&word,view->weights.data+i,sizeof word);
        printf("%s%u",i?",":"",word);
    }
    puts("]}");
}
static int gaussian_values(void) {
    for (size_t i=0;i<sizeof(gaussian_rows)/sizeof(gaussian_rows[0]);++i) {
        FjGaussianKernelInput input = {gaussian_rows[i].radius,0};
        memcpy(&input.sigma_px,&gaussian_rows[i].sigma,sizeof(float));
        FjGaussianKernelOwner* owner = NULL;
        FjGaussianKernelFailure failure = {99};
        FjGaussianKernelView view = {0};
        char text[128] = "seed";
        FjErrorBuffer error = {text,sizeof text,99};
        FjStatus s = fj_legacy_gaussian_kernel_acquire(&input,&owner,&failure,&error);
        CHECK(status(s,gaussian_rows[i].reason?3:0) && failure.reason==gaussian_rows[i].reason);
        if (failure.reason) {
            CHECK(owner==NULL && strcmp(text,failure.reason==2?"Gaussian kernel radius outside supported range":"invalid Gaussian kernel sigma")==0);
        } else {
            CHECK(owner!=NULL && error.length==0 && text[0]==0);
            s = fj_legacy_gaussian_kernel_view(owner,&view,&failure,&error);
            CHECK(status(s,0) && failure.reason==0 && view.radius==input.radius && view.weights.count==gaussian_rows[i].count && view.weights.data!=NULL);
            uint32_t sigma; memcpy(&sigma,&view.sigma_px,sizeof sigma); CHECK(sigma==gaussian_rows[i].sigma);
            for (size_t j=0;j<view.weights.count;++j) {
                uint32_t word; memcpy(&word,view.weights.data+j,sizeof word); CHECK(word==gaussian_rows[i].words[j]);
            }
        }
        gaussian_result(gaussian_rows[i].name,s,failure.reason,&view);
        CHECK(status(fj_legacy_gaussian_kernel_release(owner,NULL),0));
    }
    const char* names[]={"radius-upper-reject","null-input","unaligned-input","null-owner-output","null-failure","malformed-diagnostic","null-view-owner","null-view-output","null-view-failure","view-malformed-diagnostic","zero-capacity","null-release","release-malformed-diagnostic"};
    for (unsigned i=0;i<13;++i) {
        FjGaussianKernelInput input={i==0?2049:3,1};
        FjGaussianKernelOwner* owner=NULL;
        FjGaussianKernelFailure failure={99};
        FjGaussianKernelView view;
        memset(&view,0x55,sizeof view);
        FjErrorBuffer malformed={NULL,1,99}, zero={(char*)(uintptr_t)1,0,99};
        FjStatus s;
        if (i<=5) {
            owner=(FjGaussianKernelOwner*)(uintptr_t)1;
            s=fj_legacy_gaussian_kernel_acquire(i==1?NULL:i==2?(const FjGaussianKernelInput*)(uintptr_t)1:&input,i==3?NULL:&owner,i==4?NULL:&failure,i==5?&malformed:NULL);
            CHECK(i==3 || owner==NULL);
        } else if (i<=9) {
            CHECK(status(fj_legacy_gaussian_kernel_acquire(&input,&owner,&failure,NULL),0));
            s=fj_legacy_gaussian_kernel_view(i==6?NULL:owner,i==7?NULL:&view,i==8?NULL:&failure,i==9?&malformed:NULL);
            CHECK(i==7 || (view.radius==0 && view.sigma_px==0 && view.weights.data==NULL && view.weights.count==0));
            CHECK(status(fj_legacy_gaussian_kernel_release(owner,NULL),0));
        } else if (i==10) {
            s=fj_legacy_gaussian_kernel_acquire(&input,&owner,&failure,&zero);
            CHECK(owner!=NULL && zero.length==0);
            CHECK(status(fj_legacy_gaussian_kernel_release(owner,&zero),0));
        } else if (i==11) s=fj_legacy_gaussian_kernel_release(NULL,NULL);
        else {
            CHECK(status(fj_legacy_gaussian_kernel_acquire(&input,&owner,&failure,NULL),0));
            s=fj_legacy_gaussian_kernel_release(owner,&malformed);
        }
        const uint32_t reason=i==0?2:(i==10||i==11?0:1);
        CHECK(status(s,reason==2?3:reason?2:0));
        CHECK(i==4 || i==8 || i>=11 || failure.reason==reason);
        gaussian_result(names[i],s,reason,NULL);
    }
    return 0;
}


static uint32_t frame_pixel_word(float pixel) {
    uint32_t word;
    memcpy(&word, &pixel, sizeof(word));
    return word;
}
static uint64_t frame_diffusion_word(float pixel) {
    const double widened = (double)pixel;
    uint64_t word;
    memcpy(&word, &widened, sizeof(word));
    return word;
}
static int frame_values(void) {
    for (size_t i = 0; i < sizeof(frame_rows)/sizeof(frame_rows[0]); ++i) {
        const int op = frame_rows[i].operation, kind = frame_rows[i].kind;
        FjRect bounds = {frame_rows[i].input[0],frame_rows[i].input[1],frame_rows[i].input[2],frame_rows[i].input[3]};
        FjFrameGeometryInput input = {{bounds.x1,bounds.y1,bounds.x2,bounds.y2},0};
        memcpy(&input.film_format_long_edge_mm,&frame_rows[i].film,sizeof(float));
        FjExtent domain = {7,8,9,10};
        FjFrameGeometry geometry = {{7,8,9,10},-9};
        FjFrameGeometryFailure failure = {99};
        const void* in = op ? (const void*)&input : (const void*)&bounds;
        void* out = op ? (void*)&geometry : (void*)&domain;
        FjFrameGeometryFailure* rejected = &failure;
        char text[128]; memset(text,'!',sizeof(text));
        FjErrorBuffer error = {text,sizeof(text),99};
        FjErrorBuffer* diagnostic = &error;
        switch (kind) {
            case 0: case 14: case 15: in=NULL; break;
            case 1: out=NULL; break;
            case 2: rejected=NULL; break;
            case 3: in=(const void*)(uintptr_t)1; break;
            case 4: out=(void*)(uintptr_t)1; break;
            case 5: rejected=(FjFrameGeometryFailure*)(uintptr_t)1; break;
            case 6: in=(const void*)(UINTPTR_MAX-3); break;
            case 7: out=(void*)(UINTPTR_MAX-3); break;
            case 8: rejected=(FjFrameGeometryFailure*)(UINTPTR_MAX-3); break;
            case 9: error.data=NULL; error.capacity=1; break;
            case 10: diagnostic=(FjErrorBuffer*)(uintptr_t)1; break;
            case 11: error.data=(char*)(UINTPTR_MAX-1); error.capacity=8; break;
            case 12: diagnostic=NULL; break;
            case 13: error.data=(char*)(uintptr_t)1; error.capacity=0; break;
            default: break;
        }
        if (kind==14) error.capacity=1;
        if (kind==15) error.capacity=8;
        const FjStatus result = op
            ? fj_legacy_frame_geometry_prepare((const FjFrameGeometryInput*)in,(FjFrameGeometry*)out,rejected,diagnostic)
            : fj_legacy_frame_domain_prepare((const FjRect*)in,(FjExtent*)out,rejected,diagnostic);
        CHECK(status(result,frame_rows[i].category));
        CHECK(!frame_rows[i].failure_valid || failure.reason==frame_rows[i].reason);
        const FjExtent actual = op ? geometry.full_frame : domain;
        if (frame_rows[i].output_valid) {
            CHECK(actual.x==frame_rows[i].expected[0] && actual.y==frame_rows[i].expected[1] && actual.width==frame_rows[i].expected[2] && actual.height==frame_rows[i].expected[3]);
            CHECK(!op || (frame_pixel_word(geometry.pixel_size_um)==frame_rows[i].pixel && frame_diffusion_word(geometry.pixel_size_um)==frame_rows[i].wide));
        }
        if (frame_rows[i].diagnostic) {
            CHECK(error.length==strlen(frame_rows[i].diagnostic));
            if (error.capacity) CHECK(strcmp(text,frame_rows[i].diagnostic)==0);
            if (kind==14 || kind==15) CHECK(text[error.capacity]=='!');
        }
        printf("FRAME_CASE {\"case\":\"%s\",\"envelope\":[%u,%u,%d,",frame_rows[i].name,result.category,result.api,result.native_code);
        if (frame_rows[i].failure_valid) printf("%u",failure.reason); else printf("null");
        printf("],\"domain\":");
        if (frame_rows[i].output_valid) printf("[%d,%d,%d,%d]",actual.x,actual.y,actual.width,actual.height); else printf("null");
        printf(",\"pixel_bits\":");
        if (op && frame_rows[i].output_valid) printf("%" PRIu32,frame_pixel_word(geometry.pixel_size_um)); else printf("null");
        printf(",\"diffusion_bits\":");
        if (op && frame_rows[i].output_valid) printf("%" PRIu64,frame_diffusion_word(geometry.pixel_size_um)); else printf("null");
        printf(",\"diagnostic\":");
        if (frame_rows[i].diagnostic) printf("\"%s\"",error.capacity?text:""); else printf("null");
        printf("}\n");
    }
    return 0;
}


static size_t halation_frame_words(const FjScatterHalation* frame, uint32_t words_out[529]) {
    size_t count = 0;
    memcpy(&words_out[count++], &frame->scatter_amount, sizeof(uint32_t));
    for (size_t channel = 0; channel < 3; ++channel) {
        const FjHalationChannel* c = &frame->channels[channel];
        for (size_t component = 0; component < 7; ++component) {
            const FjHalationGaussian* g = component == 0 ? &c->core : component < 4 ? &c->tail[component - 1] : &c->bounce[component - 4];
            words_out[count++] = g->kind;
            words_out[count++] = (uint32_t)g->radius;
            for (size_t i = 0; i < 19; ++i)
                memcpy(&words_out[count++], &g->fir_weights[i], sizeof(uint32_t));
            memcpy(&words_out[count++], &g->feedforward, sizeof(uint32_t));
            for (size_t i = 0; i < 3; ++i)
                memcpy(&words_out[count++], &g->feedback[i], sizeof(uint32_t));
        }
        memcpy(&words_out[count++], &c->total_strength, sizeof(uint32_t));
    }
    return count;
}

static int halation_frame_values(void) {
    for (size_t index = 0; index < sizeof(halation_frame_rows) / sizeof(halation_frame_rows[0]); ++index) {
        const HalationFrameRow* expected = &halation_frame_rows[index];
        FjHalationFrameInput input = {0};
        input.recipe.scatter_active = expected->flags[0];
        input.recipe.back_reflection_active = expected->flags[1];
        input.recipe.hash = expected->recipe_hash;
        float* fields[10] = {&input.recipe.scatter_amount, &input.recipe.scatter_spatial_scale, &input.recipe.halation_spatial_scale,
            &input.recipe.first_sigma_um[0], &input.recipe.first_sigma_um[1], &input.recipe.first_sigma_um[2],
            &input.recipe.total_strength[0], &input.recipe.total_strength[1], &input.recipe.total_strength[2], &input.pixel_size_um};
        for (size_t i = 0; i < 10; ++i)
            memcpy(fields[i], &expected->input[i], sizeof(float));
        FjScatterHalation output;
        memset(&output, 0x55, sizeof(output));
        FjHalationFrameFailure failure = {99, 98, 97, 96, -1.0};
        char text[256] = "seed";
        FjErrorBuffer error = {text, sizeof(text), 99};
        /* Real owned storage supplies malformed alignments; numeric rejection
         * must precede any typed access. All valid peers remain disjoint. */
        _Alignas(FjHalationFrameInput) unsigned char bad_input[sizeof(FjHalationFrameInput) + 1] = {0};
        _Alignas(FjScatterHalation) unsigned char bad_output[sizeof(FjScatterHalation) + 1] = {0};
        _Alignas(FjHalationFrameFailure) unsigned char bad_failure[sizeof(FjHalationFrameFailure) + 1] = {0};
        _Alignas(FjErrorBuffer) unsigned char bad_error[sizeof(FjErrorBuffer) + 1] = {0};
        const FjHalationFrameInput* input_slot = &input;
        FjScatterHalation* output_slot = &output;
        FjHalationFrameFailure* failure_slot = &failure;
        FjErrorBuffer* error_slot = &error;
        const uint32_t mode = expected->mode;
        if (mode == 1 || mode == 9 || mode == 10) input_slot = NULL;
        if (mode == 2) output_slot = NULL;
        if (mode == 3) failure_slot = NULL;
        if (mode == 4) { input.recipe.hash = 0; input.recipe.scatter_active = 2; }
        if (mode == 5) { input.recipe.hash = 0; input.recipe.back_reflection_active = UINT32_MAX; }
        if (mode == 6) error = (FjErrorBuffer){NULL, 1, 99};
        if (mode == 7) error_slot = NULL;
        if (mode == 8) error = (FjErrorBuffer){NULL, 0, 99};
        if (mode == 9) error.capacity = 1;
        if (mode == 10) error.capacity = 7;
        if (mode == 11) input_slot = (const FjHalationFrameInput*)(bad_input + 1);
        if (mode == 12) output_slot = (FjScatterHalation*)(bad_output + 1);
        if (mode == 13) failure_slot = (FjHalationFrameFailure*)(bad_failure + 1);
        if (mode == 14) error_slot = (FjErrorBuffer*)(bad_error + 1);
        FjStatus result = fj_legacy_scatter_halation_frame_prepare(input_slot, output_slot, failure_slot, error_slot);
        CHECK(result.category == expected->status.category && result.api == expected->status.api && result.native_code == expected->status.native_code);
        uint64_t sigma_bits = 0;
        if (expected->failure_valid) {
            CHECK(failure.reason == expected->failure[0] && failure.field == expected->failure[1] && failure.channel == expected->failure[2] && failure.index == expected->failure[3]);
            memcpy(&sigma_bits, &failure.sigma_px, sizeof(sigma_bits));
            CHECK(expected->sigma_nan ? isnan(failure.sigma_px) : sigma_bits == expected->sigma_bits);
        }
        uint32_t actual_words[529] = {0};
        if (expected->output_valid) {
            CHECK(output.recipe_hash == expected->expected_hash);
            CHECK(halation_frame_words(&output, actual_words) == 529);
            for (size_t i = 0; i < 529; ++i) CHECK(actual_words[i] == expected->words[i]);
        }
        const char* actual_text = expected->error_valid && error.data && error.capacity ? error.data : "";
        if (expected->error_valid) {
            CHECK(error.length == strlen(expected->diagnostic));
            CHECK(strncmp(actual_text, expected->diagnostic, error.length) == 0);
            if (error.data && error.capacity) CHECK(actual_text[error.length] == '\0');
        }
        printf("HALATION_FRAME_RESULT {\"case\":\"%s\",\"envelope\":[%" PRIu32 ",%" PRIu32 ",%" PRId32 "],\"failure\":", expected->name, result.category, result.api, result.native_code);
        if (expected->failure_valid) {
            printf("[%" PRIu32 ",%" PRIu32 ",%" PRIu32 ",%" PRIu32 "],\"sigma_bits\":", failure.reason, failure.field, failure.channel, failure.index);
            if (isnan(failure.sigma_px)) printf("null"); else printf("%" PRIu64, sigma_bits);
            printf(",\"sigma_nan\":%s", isnan(failure.sigma_px) ? "true" : "false");
        } else printf("null,\"sigma_bits\":null,\"sigma_nan\":null");
        printf(",\"output\":");
        if (expected->output_valid) {
            printf("{\"recipe_hash\":%" PRIu64 ",\"words\":[", output.recipe_hash);
            for (size_t i = 0; i < 529; ++i) printf("%s%" PRIu32, i ? "," : "", actual_words[i]);
            printf("]}");
        } else printf("null");
        if (expected->error_valid) printf(",\"diagnostic\":\"%.*s\"}\n", (int)error.length, actual_text);
        else printf(",\"diagnostic\":null}\n");
    }
    return 0;
}


