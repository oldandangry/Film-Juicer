static const uint64_t identities[9] = {UINT64_C(4046186183453127388), UINT64_C(671384475029644653), UINT64_C(12731739782311859738), UINT64_C(15290209877088587462), UINT64_C(4193164692924065125), UINT64_C(13270131069994659966), UINT64_C(13506520838887636573), UINT64_C(7008467876276780910), UINT64_C(7479873490961326168)};
static const uint32_t kinds[9] = {2, 1, 2, 1, 3, 4, 0, 5, 1};
static int same_words(const float* values, const uint32_t* words, size_t count) {
    for (size_t i = 0; i < count; ++i) {
        uint32_t word;
        memcpy(&word, values + i, 4);
        if (word != words[i])
            return 0;
    }
    return 1;
}
int main(void) {
    struct {
        uint64_t before;
        FjOutputColorPreparation out;
        uint64_t after;
    } guarded;
    FjOutputColorPreparation retained[9];
    for (uint32_t tag = 0; tag < 9; ++tag) {
        guarded.before = UINT64_C(0x1122334455667788);
        guarded.after = UINT64_C(0x8877665544332211);
        FjStatus status = fj_legacy_output_color(tag, &guarded.out);
        if (status.category || status.api || status.native_code || guarded.before != UINT64_C(0x1122334455667788) || guarded.after != UINT64_C(0x8877665544332211))
            return 1;
        FjOutputColorPreparation* v = &guarded.out;
        float coefs[6] = {v->encoding.gamma, v->encoding.a, v->encoding.b, v->encoding.c, v->encoding.d, v->encoding.linear_cutoff};
        if (v->output_space != tag || v->entry_hash != identities[tag] || v->encoding.schema != 1 || v->encoding.cctf_kind != kinds[tag] || !same_words(v->rgb_to_xyz, expected[tag], 9) || !same_words(v->xyz_to_rgb, expected[tag] + 9, 9) || !same_words(v->white_xyz, expected[tag] + 18, 3) || !same_words(coefs, expected[tag] + 21, 6) || !same_words(v->encoding.dwg_to_output, expected[tag] + 27, 9))
            return 2;
        retained[tag] = *v;
    }
    unsigned char zero[sizeof(FjOutputColorPreparation)] = {0};
    const uint32_t invalid[] = {9, 255, UINT32_MAX};
    for (size_t i = 0; i < 3; ++i) {
        memset(&guarded.out, 0xa5, sizeof guarded.out);
        if (fj_legacy_output_color(invalid[i], &guarded.out).category != FJ_STATUS_UNSUPPORTED_INPUT || memcmp(&guarded.out, zero, sizeof guarded.out))
            return 3;
    }
    if (fj_legacy_output_color(0, NULL).category != FJ_STATUS_UNSUPPORTED_INPUT || fj_legacy_output_color(0, (FjOutputColorPreparation*)(uintptr_t)(UINTPTR_MAX - 7)).category != FJ_STATUS_UNSUPPORTED_INPUT)
        return 4;
    for (size_t i = 0; i < 9; ++i)
        if (retained[i].entry_hash != identities[i] || !same_words(retained[i].encoding.dwg_to_output, expected[i] + 27, 9))
            return 5;
    return 0;
}
